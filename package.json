{
  "name": "kanto-labs-mcp",
  "version": "2.2.0",
  "description": "MCP server for Kanto Labs' Apify actors: video frame extraction, video to LLM context (keyframes + transcript per scene), video scene/shot detection, video to slides (PDF + slide text), video OCR (on-screen text, burned-in subtitles), AI image upscaling, Douyin (抖音) video transcripts and 1688.com wholesale product search.",
  "mcpName": "io.github.Akhiyugo/kanto-labs-mcp",
  "type": "module",
  "bin": {
    "kanto-labs-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "actors.config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/sync-meta.mjs",
    "start": "node dist/index.js",
    "test": "node scripts/sync-meta.mjs --check && node test/smoke.mjs && node test/mock.mjs",
    "test:live": "node test/live.mjs",
    "prepublishOnly": "npm run build",
    "bundle": "node scripts/bundle.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apify",
    "video-frames",
    "video-to-text",
    "llm-context",
    "scene-detection",
    "shot-detection",
    "edl",
    "whisper",
    "keyframes",
    "video-to-slides",
    "video-ocr",
    "burned-in-subtitles",
    "image-upscaler",
    "real-esrgan",
    "kanto-labs"
  ],
  "author": "Kanto Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanto-labs/kanto-labs-mcp.git"
  },
  "homepage": "https://github.com/kanto-labs/kanto-labs-mcp#readme",
  "bugs": {
    "url": "https://github.com/kanto-labs/kanto-labs-mcp/issues"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
